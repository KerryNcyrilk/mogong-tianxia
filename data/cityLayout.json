  "clear_rules": [
    "校場內部（tile x5–9、y7–13）必須保持空：唔准放建築、樹、旗以外嘅裝飾、NPC。",
    "官府院落（x14–21、y4–12）內只准官府自身組件（主殿、配殿、院牆、門樓、石階、院內草地／花樹／立石）。",
    "主幹道（x12–13、y5–17）唔准有任何物件壓住；路口交叉位要留出至少 1 tile 空地。",
    "城牆內側 1 tile（x1 / x26 / y1 / y18）係【地面草帶】，唔係【淨空帶】：貼牆建築（民居、市場、宗廟、花樹、樹林）可以坐落草帶上，但地面仍要見到至少 0.5 tile 連續草地，唔准把草地完全鋪成石面；城牆立面本身唔准被任何 sprite 遮住超過 1/3 高。",
    "所有建築貼路擺：建築嘅外框要接到最近嘅石板路，唔可以漂浮喺草地中間。",
    "【建築間距】只約束同類量產建築：民居之間、資源田之間最少留 1 tile。地標建築（官府／市場／馬場／宗廟／營房／倉庫／兵營）之間可以互貼，因為原版本身就係密集院落式排列；實際要求改為相鄰 sprite 嘅「遮擋率」——上層 sprite 遮住鄰居主體立面唔可以超過 25%，遮住窗／門／匾額即算違規。"
  ],
  "sprite_rules": {
    "anchor": "所有 sprite 錨點 = 底部中心（foot anchor），世界座標 y 值以腳底為準",
    "sorting": "按 anchor.y 由細至大繪製（y 大者後畫＝在上）",
    "wall_segments": "城牆分 3 段（北／西／東／南兩段）分別繪製，令城內物件可以夾喺牆前後",
    "oversize": "sprite 可以大過佔地範圍（例如主殿屋簷伸出），但腳底落位必須對正佔地中心，伸出量 ≤ 0.5 tile",
    "padding": "每張 sprite 四周留 8px 透明邊，避免採樣漏色；相鄰 sprite 之間保持 1–2px 重疊，避免草地露縫",
    "shadow": "陰影唔可以烘死喺 sprite 內（除底圖烘焙），建築用統一半透明橢圓陰影圖層",
    "canvas_formula": {
      "ground_projection_w": "(w + h) × 48",
      "ground_projection_h": "(w + h) × 24",
      "canvas_w": "(w + h) × 48 + 24（左右各 12px 出血）",
      "canvas_h": "(w + h) × 24 + H + 16（H＝該資產立面高，上下各 8px）",
